<Window x:Class="Hub.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hub.ViewModels.Settings"
        xmlns:controls="clr-namespace:Hub.Controls"
        mc:Ignorable="d"
        Title="Hub Settings"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FF111111"
        Foreground="White">
    <Window.Resources>
        <!-- DataTemplates telling WPF how to draw each ViewModel type -->
        <DataTemplate DataType="{x:Type vm:StringSettingItem}">
            <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                <controls:SettingRowControl.SettingContent>
                    <controls:StringSettingControl TextValue="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingRowControl.SettingContent>
            </controls:SettingRowControl>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:BoolSettingItem}">
            <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                <controls:SettingRowControl.SettingContent>
                    <controls:BoolSettingControl BoolValue="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingRowControl.SettingContent>
            </controls:SettingRowControl>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:EnumSettingItem}">
            <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                <controls:SettingRowControl.SettingContent>
                    <controls:EnumSettingControl EnumOptions="{Binding Options}" SelectedOption="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingRowControl.SettingContent>
            </controls:SettingRowControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DictionarySettingItem}">
            <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                <controls:SettingRowControl.SettingContent>
                    <controls:DictionarySettingControl Entries="{Binding Entries}" />
                </controls:SettingRowControl.SettingContent>
            </controls:SettingRowControl>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hub" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- Populated at runtime from AppSettings via MVVM DataTemplates -->
                    <ItemsControl x:Name="HubSettingsList" />
                    <Button Content="Save Hub Settings" Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Right" Click="SaveHub_Click" Background="#FF333333" Foreground="White" BorderBrush="#FF555555" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Provider" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ComboBox x:Name="ProviderComboBox" Height="32" SelectionChanged="ProviderComboBox_SelectionChanged" />

                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                        <!-- Populated at runtime by SettingsWindow.xaml.cs from the selected provider's
                             ProviderSettingsBase-derived type via reflection - one field per property,
                             so a provider's own validation attributes (Required/Range/...) drive both
                             the form and the Save-time validation without any XAML per provider. -->
                        <StackPanel>
                            <ItemsControl x:Name="ProviderSettingsList" />
                            <Button Content="Save Provider Settings" Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Right" Click="SaveProvider_Click" Background="#FF333333" Foreground="White" BorderBrush="#FF555555" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </ScrollViewer>
</Window>
