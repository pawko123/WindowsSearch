<Window x:Class="Hub.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hub.ViewModels.Settings"
        xmlns:controls="clr-namespace:Hub.Controls"
        mc:Ignorable="d"
        Title="Hub Settings"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FF111111"
        Foreground="White">
    <Window.Resources>
        <!-- DataTemplates telling WPF how to draw each ViewModel type -->
        <DataTemplate DataType="{x:Type vm:CategoryHeaderItem}">
            <StackPanel Margin="{Binding LeftMargin}">
                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" Foreground="#FFFFB000" Margin="0,12,0,4" />
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Description}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StringSettingItem}">
            <Grid Margin="{Binding LeftMargin}">
                <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                    <controls:SettingRowControl.SettingContent>
                        <controls:StringSettingControl TextValue="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingRowControl.SettingContent>
                </controls:SettingRowControl>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoolSettingItem}">
            <Grid Margin="{Binding LeftMargin}">
                <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                    <controls:SettingRowControl.SettingContent>
                        <controls:BoolSettingControl BoolValue="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingRowControl.SettingContent>
                </controls:SettingRowControl>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EnumSettingItem}">
            <Grid Margin="{Binding LeftMargin}">
                <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                    <controls:SettingRowControl.SettingContent>
                        <controls:EnumSettingControl EnumOptions="{Binding Options}" SelectedOption="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingRowControl.SettingContent>
                </controls:SettingRowControl>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DictionarySettingItem}">
            <Grid Margin="{Binding LeftMargin}">
                <controls:SettingRowControl Label="{Binding Label}" Description="{Binding Description}" ErrorText="{Binding ErrorText}">
                    <controls:SettingRowControl.SettingContent>
                        <controls:DictionarySettingControl Entries="{Binding Entries}" />
                    </controls:SettingRowControl.SettingContent>
                </controls:SettingRowControl>
            </Grid>
        </DataTemplate>
    </Window.Resources>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Hub" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- Populated at runtime from AppSettings via MVVM DataTemplates -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl x:Name="HubSettingsList" />
                    </ScrollViewer>
                    
                    <Button Grid.Row="2" Content="Save Hub Settings" Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Right" Click="SaveHub_Click" Background="#FF333333" Foreground="White" BorderBrush="#FF555555" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Provider" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ComboBox Grid.Row="1" x:Name="ProviderComboBox" Height="32" SelectionChanged="ProviderComboBox_SelectionChanged" />

                    <Border Grid.Row="2" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                        <!-- Populated at runtime by SettingsWindow.xaml.cs from the selected provider's
                             ProviderSettingsBase-derived type via reflection - one field per property,
                             so a provider's own validation attributes (Required/Range/...) drive both
                             the form and the Save-time validation without any XAML per provider. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <ItemsControl x:Name="ProviderSettingsList" />
                            </ScrollViewer>
                            
                            <Button Grid.Row="1" Content="Save Provider Settings" Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Right" Click="SaveProvider_Click" Background="#FF333333" Foreground="White" BorderBrush="#FF555555" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
</Window>
