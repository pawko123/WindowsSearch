<UserControl x:Class="Hub.Controls.EnumSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ComboBox ItemsSource="{Binding EnumOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
              SelectedItem="{Binding SelectedOption, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Height="32" 
              VerticalContentAlignment="Center" />
</UserControl>