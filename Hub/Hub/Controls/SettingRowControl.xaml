<UserControl x:Class="Hub.Controls.SettingRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Hub.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:NotLastItemToVisibilityConverter x:Key="NotLastItemToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 40% width for the label, 60% for the control -->
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>
        
        <!-- Left Side: Label -->
        <TextBlock Grid.Column="0" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   Foreground="#E0E0E0" 
                   FontSize="13" 
                   FontWeight="Medium" 
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" 
                   Margin="0,0,16,0" />
        
        <!-- Right Side: Icons and Input Control -->
        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Vertical Stack of Icons -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- [?] Help Icon Tooltip -->
                <Border CornerRadius="8" Width="16" Height="16" 
                        ToolTipService.InitialShowDelay="100" Cursor="Help"
                        Tag="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                                <!-- Hide the [?] icon entirely if there is no description -->
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ToolTip>
                        <!-- Custom ToolTip Styling -->
                        <ToolTip Background="#252526" BorderBrush="#3E3E42" Foreground="#D4D4D4" Padding="12" MaxWidth="300">
                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}" TextWrapping="Wrap" FontSize="12" />
                        </ToolTip>
                    </Border.ToolTip>
                    <TextBlock Text="?" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                
                <!-- [x] Error Icon Tooltip -->
                <Border CornerRadius="8" Width="16" Height="16" Margin="0,4,0,0"
                        ToolTipService.InitialShowDelay="0" Cursor="Help"
                        Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF4444" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ToolTip>
                        <ToolTip Background="#330000" BorderBrush="#FF4444" Foreground="#FFAAAA" Padding="12" MaxWidth="320">
                            <ItemsControl ItemsSource="{Binding PlacementTarget.Tag.Errors, RelativeSource={RelativeSource AncestorType=ToolTip}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding}" Foreground="#FFAAAA" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3" />
                                            <Border Height="1" Background="#FF4444" Opacity="0.35" Margin="0,6,0,3"
                                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource NotLastItemToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip>
                    </Border.ToolTip>
                    <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                </Border>
            </StackPanel>
            
            <!-- Input Control with Red Border Halo on Error -->
            <Border Grid.Column="1" BorderThickness="1" CornerRadius="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#FF4444" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentPresenter Content="{Binding SettingContent, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
