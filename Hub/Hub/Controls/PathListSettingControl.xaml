<UserControl x:Class="Hub.Controls.PathListSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Hub.Converters"
             mc:Ignorable="d" 
             d:DesignWidth="400">
    <UserControl.Resources>
        <converters:PathExistsToVisibilityConverter x:Key="PathExistsToVisibilityConverter" />
    </UserControl.Resources>
    
    <Border Background="#1A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6">
        <StackPanel>
            <!-- Paths List -->
            <ItemsControl ItemsSource="{Binding Paths, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#252526" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                
                                <!-- Missing path badge -->
                                <Border Grid.Column="1" Background="#44FF4444" BorderBrush="#88FF4444" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="6,0,6,0"
                                        Visibility="{Binding Converter={StaticResource PathExistsToVisibilityConverter}, ConverterParameter=Missing}"
                                        ToolTip="Path does not exist on disk">
                                    <TextBlock Text="not found" Foreground="#FFAAAA" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>

                                <!-- Remove Button -->
                                <Button Grid.Column="2" 
                                        Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}"
                                        Width="20" Height="20" Cursor="Hand"
                                        Background="Transparent" BorderBrush="Transparent" Foreground="#888888"
                                        ToolTip="Remove path">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="2">
                                                <TextBlock Text="✕" Foreground="{TemplateBinding Foreground}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#33FF4444" />
                                                    <Setter Property="Foreground" Value="#FF6666" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Toolbar: Custom Pattern/Path Input & Actions -->
            <StackPanel Margin="0,4,0,0">
                <!-- Row 1: Add Custom Pattern or Path (e.g. node_modules, *.log) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding DataContext.NewPathText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                             Background="#252526" Foreground="#E0E0E0" BorderBrush="#33FFFFFF" BorderThickness="1"
                             Padding="6,3" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,4,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DataContext.AddNewPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Command="{Binding DataContext.AddNewPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="+ Add"
                            Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#44FFFFFF" BorderThickness="1"
                            Padding="10,3" FontSize="11" Cursor="Hand" />
                </Grid>

                <!-- Row 2: Browse Folder & Drive Picker -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding DataContext.BrowseFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="+ Add Folder..."
                            Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#44FFFFFF" BorderThickness="1"
                            Padding="10,3" FontSize="11" Cursor="Hand" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AvailableDrives, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding SelectedDrive, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                              Width="70" Margin="6,0,4,0" FontSize="11"
                              VerticalContentAlignment="Center" />

                    <Button Grid.Column="3"
                            Command="{Binding DataContext.AddDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding SelectedDrive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="+ Add Drive"
                            Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#44FFFFFF" BorderThickness="1"
                            Padding="8,3" FontSize="11" Cursor="Hand" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
