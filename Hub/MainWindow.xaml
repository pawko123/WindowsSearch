<Window x:Class="Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        mc:Ignorable="d"
        Title="Hub"
        Width="860"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        Closing="Window_Closing">
    <Border CornerRadius="14"
            BorderThickness="2"
            BorderBrush="#FFB00000"
            Background="#CC000000"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Height="44"
                     FontSize="20"
                     Foreground="White"
                     Background="#22000000"
                     BorderBrush="#55FF0000"
                     BorderThickness="1"
                     CaretBrush="White"
                     Padding="12,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" />

            <ScrollViewer x:Name="ResultsScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Applications"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#DDFFFFFF"
                                   Margin="4,0,0,10" />

                        <ItemsControl ItemsSource="{Binding AppResults}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True" HorizontalAlignment="Left" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="ResultButton_Click"
                                            Loaded="ResultButton_Loaded"
                                            Unloaded="ResultButton_Unloaded"
                                            Tag="{Binding}"
                                            Width="168"
                                            Height="168"
                                            Margin="8"
                                            Padding="10"
                                            Background="#12000000"
                                            BorderBrush="#44FF0000"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="itemBorder"
                                                        CornerRadius="10"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#2A330000" />
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="#FFFF4A4A" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#3A330000" />
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="#FFFFB000" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#4A550000" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="72" Height="72" CornerRadius="18" Background="#1AFFFFFF" Padding="10">
                                                <Image Width="52" Height="52" Stretch="Uniform" Source="{Binding IconImage}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,10,6,0" Width="144" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#B3FFFFFF" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,2,6,0" Width="144" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ProviderSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,16"
                                        Padding="12"
                                        CornerRadius="10"
                                        Background="#16000000"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="#1AFFFFFF" Padding="4" Margin="0,0,8,0">
                                                <Image Source="{Binding IconImage}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="ResultButton_Click"
                                                            Loaded="ResultButton_Loaded"
                                                            Unloaded="ResultButton_Unloaded"
                                                            Tag="{Binding}"
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="#0F000000"
                                                            BorderBrush="#2EFFFFFF"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="rowBorder"
                                                                        CornerRadius="8"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="rowBorder" Property="Background" Value="#24000000" />
                                                                        <Setter TargetName="rowBorder" Property="BorderBrush" Value="#66FF4A4A" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter TargetName="rowBorder" Property="Background" Value="#2E1A1A1A" />
                                                                        <Setter TargetName="rowBorder" Property="BorderBrush" Value="#FFFFB000" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="rowBorder" Property="Background" Value="#34000000" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="40" Height="40" CornerRadius="8" Background="#1AFFFFFF" Padding="6" VerticalAlignment="Center">
                                                                <Image Source="{Binding IconImage}" Stretch="Uniform" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="4"
                       Foreground="#99FFFFFF"
                       FontSize="12"
                       Text="Type to search. Arrows move, Enter launches, Esc hides, click launches." />
        </Grid>
    </Border>
</Window>
