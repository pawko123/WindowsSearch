<Window x:Class="Hub.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hub Settings"
        Width="980"
        Height="920"
        MinWidth="900"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FF111111"
        Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Image resolver" Margin="0,0,0,6" />
                <ComboBox x:Name="ImageResolverComboBox" Height="32" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Provider transport" Margin="0,0,0,6" />
                <ComboBox x:Name="TransportComboBox" Height="32" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="Provider serialization" Margin="0,0,0,6" />
                <ComboBox x:Name="SerializationComboBox" Height="32" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Provider timeout seconds" Margin="0,0,0,6" />
                <TextBox x:Name="TimeoutTextBox" Height="32" Padding="8,4" />
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,12">
                <TextBlock Text="Search limit" Margin="0,0,0,6" />
                <TextBox x:Name="SearchLimitTextBox" Height="32" Padding="8,4" />
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,12">
                <TextBlock Text="Provider" Margin="0,0,0,6" />
                <ComboBox x:Name="ProviderComboBox" Height="32" SelectionChanged="ProviderComboBox_SelectionChanged" />

                <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Named Pipe endpoint" Margin="0,0,0,4" />
                        <TextBox x:Name="ProviderEndpointNamedPipeTextBox" Height="32" Padding="8,4" Margin="0,0,0,10" />

                        <TextBlock Text="HTTP endpoint" Margin="0,0,0,4" />
                        <TextBox x:Name="ProviderEndpointHttpTextBox" Height="32" Padding="8,4" Margin="0,0,0,10" />

                        <TextBlock Text="gRPC endpoint" Margin="0,0,0,4" />
                        <TextBox x:Name="ProviderEndpointGrpcTextBox" Height="32" Padding="8,4" Margin="0,0,0,10" />

                        <TextBlock Text="Provider timeout seconds" Margin="0,0,0,4" />
                        <TextBox x:Name="ProviderTimeoutTextBox" Height="32" Padding="8,4" Margin="0,0,0,10" />

                        <TextBlock Text="Provider settings" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid x:Name="ProviderSettingsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  HeadersVisibility="Column"
                                  Background="#1A1A1A"
                                  Foreground="White"
                                  Height="260"
                                  MinRowHeight="28"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#22FFFFFF"
                                  VerticalGridLinesBrush="#22FFFFFF"
                                  BorderBrush="#44FFFFFF"
                                  BorderThickness="1">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#2A2A2A" />
                                    <Setter Property="BorderBrush" Value="#44FFFFFF" />
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#1F1F1F" />
                                    <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#1F1F1F" />
                                    <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                    <Setter Property="Padding" Value="8,5" />
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Background" Value="#222222" />
                                            <Setter Property="BorderBrush" Value="#66FFFFFF" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Background" Value="#222222" />
                                            <Setter Property="BorderBrush" Value="#66FFFFFF" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel LastChildFill="False" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="CancelButton" Content="Cancel" Width="96" Margin="0,0,8,0" Click="CancelButton_Click" />
                            <Button x:Name="SaveButton" Content="Save" Width="96" Click="SaveButton_Click" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>