<Window x:Class="Hub.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hub Settings"
        Width="1180"
        Height="920"
        MinWidth="1040"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FF111111"
        Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hub" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- Populated at runtime from AppSettings via reflection - see BuildSettingsForm
                         in SettingsWindow.xaml.cs. -->
                    <StackPanel x:Name="HubSettingsPanel" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Provider" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ComboBox x:Name="ProviderComboBox" Height="32" SelectionChanged="ProviderComboBox_SelectionChanged" />

                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                        <!-- Populated at runtime by SettingsWindow.xaml.cs from the selected provider's
                             ProviderSettingsBase-derived type via reflection - one field per property,
                             so a provider's own validation attributes (Required/Range/...) drive both
                             the form and the Save-time validation without any XAML per provider. -->
                        <StackPanel x:Name="ProviderSettingsPanel" />
                    </Border>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="2" LastChildFill="False" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Width="96" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Content="Save" Width="96" Click="SaveButton_Click" />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
